# ---------------------------------------------------------------------------
# AI Fruit Shorts Studio — environment configuration
# Copy to .env.local and fill in only what you want to use.
# Everything is OPTIONAL. With no keys the app runs fully in DEMO MODE
# (local story composer, local sketches, local TTS, clearly-labelled demo clips).
# Secrets are read on the server only and are never sent to the browser.
# ---------------------------------------------------------------------------

# Force demo mode even when keys are present (true/false)
DEMO_MODE=false

# Where projects, media and the SQLite database live (default: ~/.fruit-shorts-studio).
# Keep it OUTSIDE the project folder, or the dev server reloads on every write.
DATA_DIR=

# --- Luma (paid): real AI video (Ray) and images (Photon) -------------------
# Create a key at https://lumalabs.ai/api/keys  (API billing is separate from app plans)
LUMA_API_KEY=
# Optional override, defaults to https://api.lumalabs.ai/dream-machine/v1
LUMA_BASE_URL=

# Public HTTPS URL where this app is reachable (e.g. a Cloudflare/ngrok tunnel).
# Needed only to (a) send LOCAL images (sketches/uploads) to Luma as keyframes,
# and (b) receive Luma webhooks instead of polling. Leave empty to use polling and
# Luma-hosted Photon images only.
PUBLIC_BASE_URL=

# --- Story writing (optional) ----------------------------------------------
# Anthropic Claude (paid, cheap per story). Leave empty to use the free local composer.
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5 (best quality, roughly $0.10-0.30 per story). For a cheaper option set claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Any OpenAI-compatible chat endpoint, e.g. a FREE local Ollama:
#   OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1   OPENAI_COMPAT_MODEL=llama3.1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# --- Voice (optional) ------------------------------------------------------
# Built-in: FFmpeg's flite voices (free, no setup).
# Better free local voices: Piper (pip install piper-tts) + a downloaded .onnx voice
PIPER_BIN=
PIPER_VOICES_DIR=
